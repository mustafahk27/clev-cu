# openai | anthropic
LLM_PROVIDER=openai
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
JEV_API_KEY=
JEV_BASE_URL=
# Model names must match LLM_PROVIDER.
# anthropic equivalents: PLANNER_MODEL=claude-sonnet-5, ESCALATION_MODEL=claude-haiku-4-5-20251001
# Cheapest current-gen OpenAI model for both roles. Upgrade the planner to gpt-6-sol if plans are weak.
PLANNER_MODEL=gpt-6-luna
ESCALATION_MODEL=gpt-6-luna
# jev | llm | mock
DECIDER=jev
CONFIDENCE_THRESHOLD=0.6
MARGIN=0.1
MAX_OPTIONS=200
TOKEN_BUDGET=24000
MAX_STEPS=50
HEADLESS=false
# Comma-separated domains Clev may operate on (empty = any), e.g. wikipedia.org,github.com
ALLOWED_DOMAINS=
MAX_REPLANS=3
LLM_REASONING_EFFORT=low
LLM_TIMEOUT_S=60
TRACE_FULL_OBSERVATIONS=false
CONFIRM_DESTRUCTIVE=true
DRY_RUN=false
JEV_PRICE_PER_BILLION_INPUT=42
TRACE_DIR=traces
